# Used when you run Python on the host against Postgres published by Compose.
# Inside Compose, docker-compose.yml overrides DATABASE_URL to the postgres service.
DATABASE_URL=postgresql+psycopg://ingest:ingest@localhost:5432/ingest

# Leave the connection string empty to store image URLs only.
AZURE_STORAGE_CONNECTION_STRING=
AZURE_BLOB_CONTAINER=catalog-images

CRAWL_DELAY_SECONDS=1
MAX_PAGES=2000
MAX_DEPTH=8
MAX_IMAGE_BYTES=8000000
MAX_IMAGES_PER_PRODUCT=8
